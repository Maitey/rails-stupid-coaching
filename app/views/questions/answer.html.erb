<div class="container mt-5">
  <div class="card p-4 shadow-sm">

    <h1 class="mb-4 text-center">Stupid Coaching</h1>

    <div class="mb-3">
      <p class="fw-bold">Your question:</p>
      <p class="message user-message"><%= @question %></p>
    </div>

    <div class="mb-4">
      <p class="fw-bold">Coach's answer:</p>
      <p class="message coach-message"><%= @answer %></p>
    </div>

    <div class="text-center">
      <%= link_to "Ask another question", ask_path, class: "btn btn-secondary" %>
    </div>

  </div>
</div>
